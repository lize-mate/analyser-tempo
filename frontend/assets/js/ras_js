let _toastInst = null;

function showToast(
    msg,
    type = 'success'
) {

    const el =
        document.getElementById(
            'appToast'
        );

    if (!el) return;

    document.getElementById(
        'toastMsg'
    ).textContent = msg;

    el.className =
        `toast align-items-center border-0 app-toast ${type}`;

    if (!_toastInst) {

        _toastInst =
            new bootstrap.Toast(el, {
                delay : 3500
            });
    }

    _toastInst.show();
}

